<footer class="site-footer" id="newsletter">
  <div class="container footer-grid">
    <div class="footer-brand">
      <img src="/images/logo.png" alt="Eventora lotus logo" height="48">
      <p class="footer-tagline">Plan every moment, beautifully.</p>
    </div>

    <div>
      <h2 class="footer-heading">Quick links</h2>
      <ul class="footer-links">
        <li><a href="/venues">Venues &amp; Vendors</a></li>
        <li><a href="/ideas">Ideas &amp; Advice</a></li>
        <li><a href="/budget">Budget Tracker</a></li>
        <li><a href="/checklist">Checklist</a></li>
        <li><a href="/guests">Guests &amp; RSVPs</a></li>
        <li><a href="/consultation">Free Consultation</a></li>
        <li><a href="/invites">Invites &amp; Websites</a></li>
        <li><a href="/favorites">Favourites</a></li>
        <li><a href="/ora">Ora AI Chatbot</a></li>
      </ul>
    </div>

    <div>
      <h2 class="footer-heading">Contact</h2>
      <ul class="footer-links">
        <li><a href="mailto:hello@eventora.example">hello@eventora.example</a></li>
        <li>+91 00000 00000</li>
      </ul>
    </div>

    <div>
      <h2 class="footer-heading">Newsletter</h2>
      <form method="POST" action="/newsletter" class="newsletter-form">
        <label for="newsletter-email" class="form-label">Email address</label>
        <div class="newsletter-row">
          <input type="email" id="newsletter-email" name="email" required
                 placeholder="you@example.com" autocomplete="email">
          <button type="submit" class="btn btn-solid">Subscribe</button>
        </div>
      </form>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>&copy; <%= new Date().getFullYear() %> Eventora</p>
  </div>
</footer>

<!-- ===== ORA FLOATING CHAT ===== -->
<button id="ora-fab" class="ora-fab" aria-label="Chat with Ora" aria-expanded="false"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></button>
<section id="ora-window" class="ora-window" hidden aria-label="Chat with Ora">
  <header class="ora-head">
    <strong>Ora</strong> · your planning assistant
    <button id="ora-close" class="ora-x" aria-label="Close chat">×</button>
  </header>
  <div id="ora-log" class="ora-log" role="log" aria-live="polite"></div>
  <div class="ora-quick">
    <button data-q="Find venues">Find venues</button>
    <button data-q="Set a budget">Set a budget</button>
    <button data-q="Make an invite">Make an invite</button>
  </div>
  <div class="ora-form">
    <label for="ora-input" class="sr-only">Message Ora</label>
    <input id="ora-input" type="text" maxlength="500" placeholder="Ask Ora anything..." autocomplete="off">
    <button id="ora-send" class="ora-send">Send</button>
  </div>
</section>

<script src="/js/ora.js"></script>
</body>
</html>
