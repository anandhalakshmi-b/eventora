<%- include('head', { pageTitle: 'Home' }) %>
<%- include('header') %>

<main id="main">

  <!-- Royal Video Hero -->
  <header class="hero">
    <video class="hero-video" autoplay muted loop playsinline poster="images/venues/1.jpg" aria-hidden="true">
      <source src="images/venues/venues.mp4" type="video/mp4">
    </video>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <p class="hero-kicker">Plan Every Life Celebration, Beautifully</p>
      <h1>Weddings, Birthdays, College Fests &amp; Corporate Celebrations</h1>
      <p>From intimate birthday parties, baby showers, and college graduations to grand weddings and corporate galas — discover verified venues, top vendors, budget calculators, and digital invites across India.</p>
      <div class="hero-actions">
        <a href="/venues" class="btn btn-solid">Explore Venues &amp; Vendors</a>
        <a href="/ideas" class="btn btn-outline">Celebration Ideas &amp; Themes</a>
        <a href="/consultation" class="btn btn-outline">Free Event Plan</a>
      </div>
    </div>
  </header>

  <!-- Section 1: Plan by Celebration Type -->
  <section class="section container" aria-labelledby="events-heading">
    <div class="section-head">
      <div>
        <h2 id="events-heading" class="section-heading">Plan by Celebration Type</h2>
        <p style="color:#64748B; margin-top:4px;">Explore tailored venues, 1-click budget presets, and custom digital invites for every life milestone.</p>
      </div>
      <a href="/venues" class="card-link" style="color:#2563EB;">Browse All Celebrations →</a>
    </div>

    <div class="card-grid">
      <% (typeof celebrationEvents !== 'undefined' ? celebrationEvents : []).forEach(function (ev) { %>
        <article class="card mod-<%= ev.color %>">
          <div class="card-banner" style="height:190px; overflow:hidden;">
            <img src="<%= ev.image %>" alt="<%= ev.name %>" class="card-img" style="width:100%; height:100%; object-fit:cover;" loading="lazy">
          </div>
          <div class="card-body" style="padding:22px; display:flex; flex-direction:column; gap:8px;">
            <span class="tag"><%= ev.tag %></span>
            <h3 class="card-title" style="font-size:1.25rem; font-weight:800;"><%= ev.name %></h3>
            <p class="card-text" style="color:#475569; font-size:0.95rem;"><%= ev.desc %></p>
            <div style="display:flex; gap:12px; margin-top:auto; padding-top:10px; flex-wrap:wrap;">
              <a href="<%= ev.venueLink %>" class="card-link">Venues →</a>
              <% if (ev.budgetLink) { %><a href="<%= ev.budgetLink %>" class="card-link">Budget →</a><% } %>
              <a href="<%= ev.inviteLink %>" class="card-link">Invites →</a>
            </div>
          </div>
        </article>
      <% }) %>
    </div>
  </section>

  <!-- Section 2: Core Platform Modules -->
  <section class="section container" aria-labelledby="features-heading">
    <div class="section-head">
      <div>
        <h2 id="features-heading" class="section-heading">Everything for Your Event</h2>
        <p style="color:#64748B; margin-top:4px;">From budget planning and venue discovery to digital invitations and guest management.</p>
      </div>
      <a href="/venues" class="card-link" style="color:#2563EB;">Browse All Listings →</a>
    </div>
    <div class="card-grid">
      <% modules.filter(function (m) { return m.path !== '/'; }).forEach(function (m) { %>
        <article class="card mod-<%= m.color %>" style="padding:24px;">
          <h3 class="card-title"><%= m.name %></h3>
          <p class="card-text" style="margin:8px 0 16px;"><%= m.desc %></p>
          <a href="<%= m.path %>" class="card-link">Start planning →</a>
        </article>
      <% }) %>
    </div>
  </section>

  <!-- About Us -->
  <section class="section about mod-cyan" aria-labelledby="about-heading">
    <div class="container">
      <h2 id="about-heading" class="section-heading">Built for Life's Greatest Moments</h2>
      <p class="about-mission">
        Our mission is to make event planning feel calm, clear, and joyful. Whether you are hosting an intimate birthday, a college graduation farewell, a grand wedding, or an executive corporate summit, Eventora brings venues, vendors, budget trackers, and invitations together in one beautiful place.
      </p>

      <h3 class="subheading">Three Simple Steps</h3>
      <ol class="steps">
        <% steps.forEach(function (s, i) { %>
          <li class="step card">
            <span class="step-number"><%= i + 1 %></span>
            <h4 class="card-title"><%= s.title %></h4>
            <p class="card-text"><%= s.text %></p>
          </li>
        <% }) %>
      </ol>

      <ul class="stats" aria-label="Key numbers">
        <% stats.forEach(function (s) { %>
          <li class="stat">
            <span class="stat-value"><%= s.value %></span>
            <span class="stat-label"><%= s.label %></span>
          </li>
        <% }) %>
      </ul>

      <div class="quotes">
        <% quotes.forEach(function (q) { %>
          <figure class="quote card">
            <blockquote><p>“<%= q.text %>”</p></blockquote>
            <figcaption class="caption"><%= q.by %></figcaption>
          </figure>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- Featured vendors preview -->
  <section class="section container" aria-labelledby="preview-heading">
    <div class="section-head">
      <h2 id="preview-heading" class="section-heading">Featured Venues &amp; Vendors</h2>
      <a href="/venues" class="card-link">See all →</a>
    </div>
    <div class="card-grid">
      <% featuredVendors.forEach(function (v) { %>
        <article class="card mod-blue" style="padding:24px;">
          <span class="tag"><%= v.category %></span>
          <h3 class="card-title"><%= v.name %></h3>
          <p class="card-text"><%= v.city %> · <%= v.price %></p>
          <a href="/venues" class="card-link">View details →</a>
        </article>
      <% }) %>
    </div>
  </section>

</main>

<%- include('footer') %>
